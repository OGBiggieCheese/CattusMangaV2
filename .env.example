# Copia este archivo como .env y cambia los valores:  cp .env.example .env
# docker compose lo lee automáticamente. El .env real nunca se sube al repositorio.

# Contraseña para entrar en la web (obligatoria con Docker).
CATTUS_PASSWORD=cambia-esta-contraseña

# Puerto de la web en tu PC (solo accesible desde el propio PC).
CATTUS_PORT=4590
